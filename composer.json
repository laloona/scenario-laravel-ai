{
  "name": "stateforge/scenario-laravel-ai",
  "description": "Laravel adapter for Stateforge Scenario AI - Implementation to generate scenario classes with AI.",
  "type": "library",
  "keywords": [
    "testing",
    "phpunit",
    "fixtures",
    "scenario",
    "state",
    "test-data",
    "laravel",
    "ai"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Christina Koenig",
      "email": "christina.koenig@looriva.de",
      "role": "lead"
    }
  ],
  "homepage": "https://github.com/laloona/scenario-laravel-ai",
  "support": {
    "issues": "https://github.com/laloona/scenario-laravel-ai/issues",
    "source": "https://github.com/laloona/scenario-laravel-ai"
  },
  "require": {
    "php": ">=8.2",
    "stateforge/scenario-laravel": "~1.2",
    "stateforge/scenario-ai": "~1.0-dev"
  },
  "autoload": {
    "psr-4": {
      "Stateforge\\Scenario\\LaravelAi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Stateforge\\Scenario\\LaravelAi\\Tests\\Unit\\": "tests/unit/"
    },
    "classmap": [
      "tests/files"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.60",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^11.5.50 || ^12.5.22 || ^13.1.6",
    "tomasvotruba/type-coverage": "^2.2"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Stateforge\\Scenario\\LaravelAi\\ScenarioLaravelAiServiceProvider"
      ]
    },
    "branch-alias": {
      "dev-main": "1.0-dev"
    }
  }
}
